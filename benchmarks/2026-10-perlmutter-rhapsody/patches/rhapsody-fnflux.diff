+                _blob = os.path.join(_dir, f"{task['uid']}.fn.pkl")
+                with open(_blob, "wb") as _f:
+                    _cp.dump((task["function"], tuple(task.get("args", ())),
+                              dict(task.get("kwargs", {}))), _f)
+                _exe = sys.executable
+                _args = [_wrap, _blob]
             # Map canonical task dictionary values to the kwargs expected by spec_from_dict
             td = {
                 "uid": task["uid"],
-                "executable": task["executable"],
-                "arguments": task.get("arguments", []),
